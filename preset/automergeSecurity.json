{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automerge security vulnerability alerts",
  "vulnerabilityAlerts": {
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "description": "Do not automerge major security bumps without review",
      "matchUpdateTypes": ["major"],
      "vulnerabilityAlerts": { "automerge": false }
    }
  ]
}
