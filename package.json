{
  "name": "@inthememory/renovate-config",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Renovate configuration presets",
  "keywords": [
    "renovate",
    "config",
    "dependencies"
  ],
  "homepage": "https://github.com/Inthememory/renovate-config/blob/main#readme",
  "bugs": {
    "url": "https://github.com/Inthememory/renovate-config.git/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inthememory/renovate-config.git"
  },
  "license": "UNLICENSED",
  "author": "VusionIntelligence",
  "type": "module",
  "scripts": {
    "build": "pnpm run \"/^build:.*/\"",
    "build:empty": ":",
    "clean": "pnpm run \"/^clean:.*/\"",
    "code-analysis": ":",
    "develop": ":",
    "docs": ":",
    "format": "pnpm run \"/^format:.*/\"",
    "format:root": "eslint . --fix",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:root": "eslint . --cache",
    "prepare": "pnpm run \"/^prepare:.*/\"",
    "prepare:skills-sync": "if [ -z \"$CI\" ]; then skills-npm --force --yes; fi",
    "release": ":",
    "rescue": "git clean -fdx; pnpm install",
    "test": "vitest run",
    "validate": "pnpm run build && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@inthememory/agent-config": "1.6.1",
    "@inthememory/commitlint-config": "1.33.1",
    "@inthememory/eslint-config": "1.23.3",
    "@inthememory/lefthook-config": "1.14.1",
    "@inthememory/tsconfig": "1.1.1",
    "@inthememory/vitest-config": "4.1.1",
    "eslint": "10.13.0",
    "renovate": "44.190.2",
    "skills-npm": "4.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=12.0.0",
    "pnpm": ">=9.0.0"
  }
}
