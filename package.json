{
  "name": "@inthememory/renovate-config",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Renovate configuration presets",
  "keywords": [
    "renovate",
    "config",
    "dependencies"
  ],
  "homepage": "https://github.com/Inthememory/renovate-config/blob/main#readme",
  "bugs": {
    "url": "https://github.com/Inthememory/renovate-config.git/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Inthememory/renovate-config.git"
  },
  "license": "UNLICENSED",
  "author": "VusionIntelligence",
  "type": "module",
  "scripts": {
    "build": "pnpm run \"/^build:.*/\"",
    "build:empty": ":",
    "clean": "pnpm run \"/^clean:.*/\"",
    "code-analysis": ":",
    "develop": ":",
    "docs": ":",
    "format": "pnpm run \"/^format:.*/\"",
    "format:root": "eslint . --fix",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:root": "eslint . --cache",
    "prepare": "pnpm run \"/^prepare:.*/\"",
    "prepare:empty": ":",
    "release": ":",
    "rescue": "git clean -fdx; pnpm install",
    "test": "vitest run",
    "validate": "pnpm run build && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@inthememory/commitlint-config": "1.20.0",
    "@inthememory/eslint-config": "1.11.0",
    "@inthememory/lefthook-config": "1.2.0",
    "@inthememory/tsconfig": "1.0.24",
    "eslint": "10.8.1",
    "renovate": "44.30.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=12.0.0",
    "pnpm": ">=9.0.0"
  }
}
